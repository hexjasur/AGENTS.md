{
  "name": "@hexjasur/agents-md",
  "version": "1.5.0",
  "description": "Install safe AGENTS.md instructions and modular Agent Skills for coding agents",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agents.md",
    "agent skills",
    "skills",
    "ai agents",
    "coding agents",
    "modern web guidance",
    "web performance",
    "accessibility",
    "seo",
    "security",
    "tauri",
    "renpy",
    "visual novel",
    "react",
    "github actions",
    "auto update",
    "cli"
  ],
  "bin": {
    "agents-md": "bin/cli.js"
  },
  "files": [
    "AGENTS.md",
    "LICENSE",
    "bin/",
    "lib/",
    "skills/",
    "evals/",
    "assets/",
    "install-agents.sh",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node bin/cli.js lint",
    "validate:skills": "node --test test/skills.test.js",
    "eval": "node bin/eval.js",
    "verify": "node bin/sync-skill-index.js --check && npm test && npm run lint -- skills --max-review-age-days 365 && npm run validate:skills && npm pack --dry-run",
    "sync:skills": "node bin/sync-skill-index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexjasur/AGENTS.md.git"
